# Expo inlines EXPO_PUBLIC_* vars into the bundle, so these are PUBLIC.
# Never put an API key here — the app must never talk to Nemotron directly
# (04 Architecture#Message bus pattern).

# IMPORTANT: on a physical phone, 127.0.0.1 is the phone itself. Use your
# laptop's LAN IP for a local server, or Maincloud for the demo:
#   EXPO_PUBLIC_SPACETIME_HOST=ws://192.168.1.20:3000
#   EXPO_PUBLIC_SPACETIME_HOST=wss://maincloud.spacetimedb.com
EXPO_PUBLIC_SPACETIME_HOST=ws://127.0.0.1:3000
EXPO_PUBLIC_SPACETIME_DB_NAME=branches
