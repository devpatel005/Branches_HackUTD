# ---------------------------------------------------------------------------
# Model provider — Gemini (07 Agent Spec#Model configuration)
# ---------------------------------------------------------------------------
# The only thing most people need to set. Get a key at https://aistudio.google.com
# (free tier requires phone verification). Rate limits are per Google Cloud
# PROJECT, not per key, so give each developer their own project and keep a
# separate one for the demo.
#
# This file is read by `npm run agent` and `npm run -w @branches/agent smoke`
# via Node's --env-file-if-exists, so a key set here is picked up with no
# shell export.
GEMINI_API_KEY=

# Overridable, but the defaults are the spec's.
#   primary  — gemini-3.8-flash at thinking_level "low"
#   fallback — gemini-3.5-flash-lite at "minimal"
# Do NOT set a small max_output_tokens anywhere: it includes thinking tokens,
# and hitting it ends the interaction `incomplete` with truncated output.
# Lower the thinking level instead.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=

# No key at all? The bundled mock speaks the Gemini Interactions shape, so the
# whole loop — bus, claim, progress, all four validation gates, retry, failover,
# truncation handling, fallbacks — runs against the real adapter:
#   npm run -w @branches/agent mock
#   GEMINI_BASE_URL=http://127.0.0.1:8099 npm run agent
#
# An ORIGIN, with no path: the SDK appends /v1/interactions itself.
GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# Secondary path: any OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# Kept so a different provider can be tried without touching code. Setting
# AGENT_BASE_URL alone switches the provider; AGENT_PROVIDER=gemini|openai
# overrides that choice explicitly.
AGENT_PROVIDER=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=

# A third tier, a different provider again, used only after Gemini errors.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------
# One call.
AGENT_TIMEOUT_MS=20000
# The whole task, across every tier and retry. Attempts alone are not a bound:
# two tiers x two attempts x a 20s timeout is 80 seconds of spinner. Must be
# longer than AGENT_TIMEOUT_MS or no call would ever start.
AGENT_TASK_BUDGET_MS=60000
# How often to sweep for jobs abandoned by a service that died mid-flight.
AGENT_RECLAIM_MS=30000

# ---------------------------------------------------------------------------
# SpacetimeDB
# ---------------------------------------------------------------------------
SPACETIME_HOST=ws://127.0.0.1:3000
SPACETIME_DB_NAME=branches

# Persist the agent's identity so it stays the same household member across
# restarts. The service prints the token on first connect.
AGENT_TOKEN=

# Must match AGENT_SHARED_SECRET in server/spacetime/src/agent-secret.ts.
AGENT_SECRET=branches-dev-agent-secret

# Which household to serve. Defaults to the newest one it can see.
AGENT_JOIN_CODE=

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Log every final prompt so verify:agent can grep it for privacy canaries.
AGENT_PROMPT_LOG=.agent-prompts.log
