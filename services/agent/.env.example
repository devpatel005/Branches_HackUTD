# Nemotron via NVIDIA's hosted, OpenAI-compatible API.
# Get a key at https://build.nvidia.com — free for the recommended models.
NVIDIA_API_KEY=

# Optional failover (07 Agent Spec). Nemotron must stay primary for the
# NVIDIA track; these are only used after Nemotron errors.
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# SpacetimeDB the agent connects to, as a normal client (04 Architecture).
SPACETIME_HOST=ws://127.0.0.1:3000
SPACETIME_DB_NAME=branches

# Persisted SpacetimeDB identity token for the agent member.
AGENT_TOKEN=
