# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# Nemotron is tier 1 by default and must stay the primary decision-maker for the
# NVIDIA track. Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=

# To try a different provider instead, set all three. Any OpenAI-compatible
# endpoint works — OpenAI, Groq, Together, a local llama.cpp.
#   AGENT_BASE_URL=https://api.openai.com/v1
#   AGENT_MODEL=gpt-4o-mini
#   AGENT_API_KEY=sk-...
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=

# No key at all? Run the bundled mock and point at it. The full loop — bus,
# claim, progress, all four validation gates, retry, failover, fallbacks — works
# against it:
#   npm run -w @branches/agent mock
#   AGENT_BASE_URL=http://127.0.0.1:8099/v1 npm run agent

# Optional third tier, a different provider, used only after Nemotron errors.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=

AGENT_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# SpacetimeDB
# ---------------------------------------------------------------------------
SPACETIME_HOST=ws://127.0.0.1:3000
SPACETIME_DB_NAME=branches

# Persist the agent's identity so it stays the same household member across
# restarts. The service prints the token on first connect.
AGENT_TOKEN=

# Must match AGENT_SHARED_SECRET in server/spacetime/src/agent-secret.ts.
AGENT_SECRET=branches-dev-agent-secret

# Which household to serve. Defaults to the first one it can see.
AGENT_JOIN_CODE=

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Log every final prompt so verify:agent can grep it for privacy canaries.
AGENT_PROMPT_LOG=.agent-prompts.log
