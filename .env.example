# Root defaults. Copy to .env and adjust. Never commit .env (see .gitignore).
# Per-service examples: apps/mobile/.env.example, services/agent/.env.example

# Local SpacetimeDB (npm run stdb:start), or Maincloud:
#   SPACETIME_HOST=wss://maincloud.spacetimedb.com
SPACETIME_HOST=ws://127.0.0.1:3000
SPACETIME_DB_NAME=branches
